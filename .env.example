# Copia este ficheiro para .env e preenche com os teus valores.
# O .env está no .gitignore — nunca commites chaves reais.

# --- Base de dados (Postgres) ------------------------------------------------
# Local: cria a BD com `createdb food_pairing` e usa localhost.
# Produção: connection string interna do serviço Postgres no Easypanel.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/food_pairing"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/food_pairing"

# --- Sessão (login por PIN) --------------------------------------------------
# Qualquer texto longo e aleatório. Sem isto, usa um valor por omissão que
# NÃO deve ficar em produção — define sempre este valor no Easypanel.
SESSAO_SEGREDO="muda-isto-para-algo-aleatorio-e-longo"
# "true" desliga a exigência de PIN (entra sempre como o primeiro funcionário
# com o papel certo). Só para períodos de teste — apaga esta linha depois.
# DESATIVAR_LOGIN="true"

# --- Claude (ingestão e enriquecimento) ------------------------------------
# console.anthropic.com > API Keys. Usada apenas no servidor.
ANTHROPIC_API_KEY="sk-ant-..."
