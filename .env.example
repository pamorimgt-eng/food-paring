# Copia este ficheiro para .env e preenche com os teus valores.
# O .env está no .gitignore — nunca commites chaves reais.

# --- Base de dados (Supabase) ----------------------------------------------
# Painel Supabase > Project Settings > Database > Connection string
# DATABASE_URL usa o pooler (porta 6543) — é o que a app usa em runtime.
DATABASE_URL="postgresql://postgres.PROJETO:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL usa a ligação direta (porta 5432) — as migrations precisam dela.
DIRECT_URL="postgresql://postgres.PROJETO:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# --- Supabase (cliente + Realtime + Storage) -------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="a-tua-anon-key"
# Só no servidor. NUNCA prefixar com NEXT_PUBLIC_ — daria acesso total à BD.
SUPABASE_SERVICE_ROLE_KEY="a-tua-service-role-key"

# --- Claude (ingestão e enriquecimento) ------------------------------------
# console.anthropic.com > API Keys. Usada apenas no servidor.
ANTHROPIC_API_KEY="sk-ant-..."
